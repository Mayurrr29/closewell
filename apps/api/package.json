    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.5",
    "multer": "2.4.0",
    "nodemailer": "7.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
