# Copy to apps/api/.env (the API reads environment variables; never commit real values).
# Everything has a development default; production REQUIRES the values marked [prod].

NODE_ENV=development
PORT=4000
# MongoDB 6+ or a MongoDB-compatible server. Atlas: mongodb+srv://user:pass@cluster/closewell
MONGODB_URI=mongodb://127.0.0.1:27017/closewell
# Where the web app is served (CORS + email links) and the API's public URL (widget snippet).
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
TRUST_PROXY=loopback
LOG_LEVEL=info

# [prod] 32+ random characters:  openssl rand -hex 32
JWT_ACCESS_SECRET=
# [prod] 32 bytes base64, encrypts stored integration credentials:  openssl rand -base64 32
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production. Set false only for plain-http local testing.
# COOKIE_SECURE=

# ---- AI provider ----
# mock = built-in rule-based simulator (no key needed, not a language model)
# openai = OpenAI Chat Completions with tool calling
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_MAX_TOOL_ROUNDS=4
# Cost ESTIMATES in USD per million tokens. Check your provider's current prices.
# AI_PRICE_TABLE={"gpt-4.1-mini":{"inputPerMTok":0.4,"outputPerMTok":1.6}}

# ---- Email ----
# mock = captured, not delivered (read them at http://localhost:5173/dev/mailbox)
EMAIL_MODE=mock
EMAIL_FROM=Closewell <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Jobs, uploads, widget ----
JOBS_ENABLED=true
JOBS_POLL_MS=2000
KNOWLEDGE_MAX_FILE_MB=5
URL_INGEST_ENABLED=true
WIDGET_RATE_LIMIT_PER_MIN=20

# Development seed password (npm run seed). Random if unset.
SEED_DEMO_PASSWORD=
